{
  "title": "PlantPulse — Executive Overview",
  "uid": "plantpulse-executive",
  "tags": ["plantpulse", "executive", "slo"],
  "timezone": "browser",
  "schemaVersion": 38,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "SLO Compliance",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "sum(plantpulse_slo_compliance_percent)",
        "legendFormat": "Compliance %"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 99.0 },
            { "color": "green", "value": 99.9 }
          ]
        }
      },
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 3, "min": 98, "max": 100 }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error Budget Remaining",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "plantpulse_error_budget_remaining_percent",
        "legendFormat": "Budget %"
      }],
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "red", "value": 0 },
            { "color": "yellow", "value": 20 },
            { "color": "green", "value": 50 }
          ]
        }
      },
      "fieldConfig": { "defaults": { "unit": "percent", "decimals": 1 } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Open Critical Incidents",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "plantpulse_incidents_total{status=\"open\",severity=\"critical\"}",
        "legendFormat": "Critical"
      }],
      "options": {
        "colorMode": "background",
        "thresholds": {
          "steps": [
            { "color": "green", "value": 0 },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 3 }
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Events / Second",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "rate(plantpulse_telemetry_events_total[1m])",
        "legendFormat": "Events/s"
      }],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 0 } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Machine Health Distribution",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "plantpulse_machines_by_severity{severity=\"critical\"}", "legendFormat": "Critical" },
        { "expr": "plantpulse_machines_by_severity{severity=\"warning\"}", "legendFormat": "Warning" },
        { "expr": "plantpulse_machines_by_severity{severity=\"normal\"}", "legendFormat": "Normal" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Critical" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "Warning" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "yellow" } }] },
          { "matcher": { "id": "byName", "options": "Normal" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Burn Rate (1h rolling)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [{
        "expr": "plantpulse_slo_burn_rate",
        "legendFormat": "Burn Rate"
      }],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 2 },
        "overrides": [{
          "matcher": { "id": "byName", "options": "Burn Rate" },
          "properties": [{ "id": "thresholds", "value": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }}]
        }]
      }
    }
  ]
}
